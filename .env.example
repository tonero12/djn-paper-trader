# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected at runtime on Cloud Run)
APP_URL="MY_APP_URL"

# Telegram Bot Credentials
# Obtain from @BotFather in Telegram using /newbot
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"

# Webhook Security Token (configured when setting Telegram webhook)
# Telegram will send this header in 'X-Telegram-Bot-Api-Secret-Token'
TELEGRAM_WEBHOOK_SECRET="a_random_32_character_secret_string"

# Public Base URL for webhook routing and asset generation
PUBLIC_BASE_URL="https://my-service-xyz.run.app"

# Administrative API Key to protect admin endpoints and diagnostic tools
ADMIN_API_KEY="admin_secret_passcode"

# Google Cloud / Firestore Settings (Optional if using Cloud Run default credentials)
GCP_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
FIRESTORE_EMULATOR_HOST=""
